# Copy this file to `.env` (or to `.secrets/cdse.env`) and fill in the real
# values. The real file is git-ignored — never commit it, never paste it into a
# chat, and rotate the secret if it was ever committed.
#
#   cp .env.example .secrets/cdse.env
#
# `scripts/cdse_env.py` is the only place these are read, and the secret is never
# printed, logged or written into results/.

# --- Copernicus Data Space Ecosystem (Sentinel-1 / Sentinel-2 downloads) ------
# Free account: https://dataspace.copernicus.eu -> Identity & Access Management
# -> create an OAuth client -> copy the client ID and secret (shown once).
CDSE_CLIENT_ID=your_client_id_here
CDSE_CLIENT_SECRET=your_client_secret_here

# --- Dashboard (all optional) -------------------------------------------------
# Leave empty to let the dashboard generate a token at startup and print it once.
JALNETRA_PIPELINE_TOKEN=
# Bind address. Loopback by default; set 0.0.0.0 only for a deliberate LAN demo.
JALNETRA_HOST=127.0.0.1
# Debug is ignored unless the bind address is loopback (the Werkzeug console is
# a live Python REPL).
JALNETRA_DEBUG=0
