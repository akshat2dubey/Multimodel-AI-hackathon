# never commit secrets
.secrets/
.env
*.env
!.env.example

# real downloads and real pipeline output (large, and not ours to redistribute)
data/
results/
logs/

# synthetic fixture trees (demo/make_demo_data.py + demo/run_offline.py)
data_demo/
results_demo/

# model weights are large binaries; models/README.md explains how to obtain or
# retrain them, and the pipeline runs without one (log-ratio baseline fallback)
models/*
!models/README.md
*.pt

# raster / archive outputs
*.tif
*.tiff
*.jpg
*.jpeg
*.png
*.gif
# except the vendored front-end assets the dashboard ships with
!dashboard/static/vendor/**
*.pdf
*.zip
*.tar.gz
*.gz

# python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# tooling
.ruff_cache/
.mypy_cache/
.pytest_cache/
.vscode/
.idea/
*.swp
*.swo
*.log
tmp_*
